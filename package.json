{
  "name": "gland-padalarang-residence",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "check": "astro check",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src package.json tsconfig.json biome.json astro.config.mjs",
    "format": "biome format --write src package.json tsconfig.json biome.json astro.config.mjs",
    "build": "astro build",
    "preview": "astro preview",
    "verify": "pnpm check && pnpm typecheck && pnpm lint && pnpm build"
  },
  "dependencies": {
    "@astrojs/react": "^6.0.5",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "astro": "7.3.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@biomejs/biome": "2.5.13",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.185.4",
    "typescript": "5.9.3"
  }
}
