---
import { project } from "../data/project";
import "../styles/global.css";

const title = "G-Land Padalarang Residence | Pilihan Hunian di Padalarang";
const description = "Kenali pilihan hunian, fasilitas, dan lokasi G-Land Padalarang Residence. Hubungi marketing melalui WhatsApp untuk mengonfirmasi harga, spesifikasi, dan ketersediaan.";
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
const socialImage = Astro.site ? new URL("/images/gate.webp", Astro.site).href : undefined;
const structuredData = {
  "@context": "https://schema.org",
  "@type": "Place",
  name: project.name,
  address: project.address,
  telephone: `+${project.whatsapp}`,
  geo: {
    "@type": "GeoCoordinates",
    latitude: project.latitude,
    longitude: project.longitude,
  },
  ...(canonical ? { url: canonical } : {}),
};
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#F5F6F2" />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" href="/fonts/manrope-latin.woff2" as="font" type="font/woff2" crossorigin />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="id_ID" />
    <meta property="og:site_name" content={project.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    {socialImage && <>
      <meta property="og:image" content={socialImage} />
      <meta property="og:image:width" content="1200" />
      <meta property="og:image:height" content="583" />
      <meta property="og:image:alt" content="Visualisasi gerbang G-Land Padalarang Residence" />
    </>}
    <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData).replaceAll("<", "\\u003c")} />
  </head>
  <body>
    <a href="#konten" class="skip-link">Lewati ke konten</a>
    <slot />
  </body>
</html>
