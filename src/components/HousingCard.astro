---
import type { ProjectImage } from "../data/media";
import { whatsappLink } from "../data/project";
import ActionLink from "./ActionLink.astro";
import ProjectFigure from "./ProjectFigure.astro";

interface Props { readonly image: ProjectImage; }
const { image } = Astro.props;
const href = whatsappLink(`Halo tim marketing G-Land Padalarang Residence, saya tertarik dengan ${image.title}. Mohon informasi harga, spesifikasi, ketersediaan, dan dokumen legalnya. Terima kasih.`);
---

<article>
  <ProjectFigure image={image} />
  <h3>{image.title}</h3>
  <ActionLink href={href} variant="text" external>Tanyakan {image.title}</ActionLink>
</article>

<style>
  article { min-inline-size: 0; }
  h3 { margin-block-start: var(--space-4); margin-block-end: var(--space-3); }
</style>
